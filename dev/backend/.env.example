APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://knowledge_preview:knowledge_preview@localhost:5432/knowledge_preview?sslmode=disable
# GitHub OAuth / session authentication
# GITHUB_REDIRECT_URL defaults to ${APP_ORIGIN}/api/v1/auth/github/callback.
# AUTH_ALLOWED_GITHUB_IDS is a comma-separated allowlist of numeric GitHub IDs.
# JWT_SIGNING_KEY must contain at least 32 random bytes in the deployed secret.
# APP_ORIGIN=https://app.example.test
# GITHUB_CLIENT_ID=replace-me
# GITHUB_CLIENT_SECRET=replace-me
# AUTH_ALLOWED_GITHUB_IDS=123456
# JWT_SIGNING_KEY=replace-with-a-secret-at-least-32-bytes
# JWT_ISSUER=knowledge-preview
# JWT_AUDIENCE=knowledge-preview-web
# AUTH_ACCESS_TTL=15m
# AUTH_REFRESH_TTL=720h
# AUTH_STATE_TTL=10m
# GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_USER_URL=https://api.github.com/user

# ナレッジ保存の設定は、#19の認証と#15のアップロードを接続するまでは任意。
# 保存を有効にする場合は以下をすべて設定し、作成済みの非公開バケットを使用する。
# APP_ORIGIN=https://app.example.test
# PREVIEW_ORIGIN=https://preview.example.test
# S3_ENDPOINT=minio:9000
# S3_BUCKET=knowledge-private
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# S3_INSECURE=true
